# ==========================================
# Stage 1: Build the Go Binary
# ==========================================
FROM golang:1.22-alpine AS builder

# Install git and ca-certificates (required for fetching modules and TLS)
RUN apk add --no-cache git ca-certificates

WORKDIR /build

# Copy dependency files first to leverage Docker layer caching
COPY go.mod go.sum ./
RUN go mod download && go mod verify

# Copy the rest of the source code
COPY . .

# Build the binary with security and size optimizations:
# CGO_ENABLED=0: Static binary (no C dependencies)
# -ldflags="-s -w": Strip debug symbols and DWARF generation (reduces size significantly)
# -trimpath: Remove file system paths from the compiled binary for reproducibility
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-s -w -X main.version=1.0.0" \
    -trimpath \
    -o /build/webhook-relay \
    ./cmd/api/main.go

# ==========================================
# Stage 2: Create Minimal Runtime Image
# ==========================================
FROM alpine:3.19

# Install runtime dependencies
# ca-certificates: For HTTPS outbound calls to 3rd party webhooks
# tzdata: For accurate timestamp logging
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S appgroup \
    && adduser -S appuser -G appgroup

WORKDIR /app

# Copy the binary from the builder stage
COPY --from=builder /build/webhook-relay .

# Copy the database migrations (required for the app to run migrations on startup if configured)
COPY --from=builder /build/db/migrations ./db/migrations

# Change ownership of the app directory to the non-root user
RUN chown -R appuser:appgroup /app

# Switch to non-root user (CRITICAL SECURITY PRACTICE)
USER appuser

# Expose the application port
EXPOSE 3000

# Healthcheck using wget (available in alpine) to hit the live endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health/live || exit 1

# Run the binary
ENTRYPOINT ["./webhook-relay"]