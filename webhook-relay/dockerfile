# ==============================================================================
# STAGE 1: BUILDER
# Compiles the Go binary with static linking for maximum portability.
# ==============================================================================
FROM golang:1.26.4-alpine AS builder

# Install build dependencies
# git: required for go mod download if dependencies are hosted on Git
# ca-certificates: required for HTTPS requests
# tzdata: required for correct time zone handling in Go
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /app

# Copy go mod files first to leverage Docker layer caching.
# Dependencies are only re-downloaded if go.mod/go.sum change.
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest of the source code
COPY . .

# Build the binary.
# CGO_ENABLED=0: Ensures a statically linked binary (no external C dependencies).
# GOOS=linux: Targets Linux OS.
# -ldflags="-w -s": Strips debug symbols and DWARF info to minimize binary size.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o webhook-relay ./cmd/api

# ==============================================================================
# STAGE 2: PRODUCTION RUNTIME
# Minimal, secure, non-root Alpine image.
# ==============================================================================
FROM alpine:3.19 AS production

# Install runtime dependencies
# ca-certificates: for outbound HTTPS requests
# tzdata: for correct timestamps in logs
# wget: required for the Docker HEALTHCHECK command
RUN apk --no-cache add ca-certificates tzdata wget

# Create a non-root user and group for Zero-Trust Security
# (backend_skills.md §5A: Zero-Trust Security)
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

WORKDIR /app

# Copy the compiled binary from the builder stage
COPY --from=builder /app/webhook-relay .

# Change ownership of the binary and working directory to the non-root user
RUN chown -R appuser:appgroup /app

# Switch to the non-root user
USER appuser

# Expose the application port
EXPOSE 3000

# Health check (integration_skills.md: Zero-Downtime & Resilience)
# Checks the /health/live endpoint every 30 seconds.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health/live || exit 1

# Run the application
CMD ["./webhook-relay"]