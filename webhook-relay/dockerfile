# ==============================================================================
# STAGE 1: BUILDER
# Compiles the Go binary with static linking for maximum portability.
# ==============================================================================
FROM golang:1.26.4-alpine AS builder

# Install build dependencies
RUN apk --no-cache add ca-certificates tzdata curl

# Set working directory
WORKDIR /app

# Copy go mod files first to leverage Docker layer caching.
COPY go.mod go.sum ./
RUN go mod download

# Copy the rest of the source code
COPY . .

# Build the binary.
# CGO_ENABLED=0: Ensures a statically linked binary (no external C dependencies).
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-w -s" -o webhook-relay ./cmd/api

# ==============================================================================
# STAGE 2: PRODUCTION RUNTIME
# Minimal, secure, non-root Alpine image.
# ==============================================================================
FROM alpine:3.19 AS production

# ✅ FIX: Install 'curl' instead of 'wget' for reliable HTTP healthchecks
RUN apk --no-cache add ca-certificates tzdata curl

# Create a non-root user and group for Zero-Trust Security
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

WORKDIR /app

# Copy the compiled binary from the builder stage
COPY --from=builder /app/webhook-relay .

# Change ownership of the binary and working directory to the non-root user
RUN chown -R appuser:appgroup /app

# Switch to the non-root user
USER appuser

# Expose the application port
EXPOSE 3000

# ✅ FIX: Use 'curl -f' which correctly interprets 200 OK with empty body as success
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://127.0.0.1:3000/health/live || exit 1

# Run the application
CMD ["./webhook-relay"]